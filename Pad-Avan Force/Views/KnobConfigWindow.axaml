<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PadAwan_Force.Views"
        x:Class="PadAwan_Force.Views.KnobConfigWindow"
        Title="Knob Configuration"
        Width="600" Height="600"
        CanResize="False"
        Background="Black"
        Icon="/Assets/Pad-Avan Force logo v2.ico"
        WindowStartupLocation="CenterOwner">
  
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top horizontal rectangle -->
    <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Fill="#1A1A1A" 
               Height="55" 
               VerticalAlignment="Top" 
               Margin="-30,-30,-30,0"/>
    
    <!-- Bottom horizontal rectangle -->
    <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
               Fill="#1A1A1A" 
               Height="55" 
               VerticalAlignment="Bottom" 
               Margin="-30,0,-30,-30"/>
    
    <!-- Title -->
    <TextBlock Grid.Row="0" 
               Text="Configuration:" 
               FontSize="32" 
               FontWeight="Bold" 
               Foreground="#00FFFF"
               HorizontalAlignment="Left" 
               Margin="-10,-22,0,20"/>

    <!-- Knob Reference -->  
    <TextBlock x:Name="KnobNumberText"
               Text="Knob A"
               FontSize="32" 
               FontWeight="Bold" 
               Foreground="#00FFFF"
               HorizontalAlignment="Right" 
               Margin="-10,-22,0,20"/>
    
    <!-- Configuration Content -->
    <Grid Grid.Row="1" Margin="0,35,0,0">
      <StackPanel HorizontalAlignment="Center" Spacing="20">

        <!-- Upper Section: CCW Action | Knob Circle | CW Action -->
        <Grid ColumnDefinitions="180,180,180" HorizontalAlignment="Center">
          
          <!-- Left Side - CCW Action -->
          <StackPanel Grid.Column="0" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center">
            <TextBlock Text="↺" 
                       FontSize="28" 
                       Foreground="#00FFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
            <TextBlock Text="CCW Action:" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <ComboBox x:Name="CcwActionComboBox"
                      Width="160" 
                      Height="35" 
                      FontSize="14" 
                      Background="#404040" 
                      Foreground="White" 
                      BorderBrush="#707070" 
                      BorderThickness="2" 
                      CornerRadius="5"
                      HorizontalAlignment="Center">
              <ComboBoxItem Content="Increase Volume"/>
              <ComboBoxItem Content="Decrease Volume"/>
              <ComboBoxItem Content="Scroll Up"/>
              <ComboBoxItem Content="Scroll Down"/>
              <ComboBoxItem Content="Layer Count Up"/>
              <ComboBoxItem Content="Layer Count Down"/>
              <ComboBoxItem Content="None"/>
            </ComboBox>
          </StackPanel>
          
          <!-- Central Knob Circle -->
          <Border Grid.Column="1"
                  Width="130" Height="130"
                  Background="#00FFFF"
                  BorderBrush="#00FFFF"
                  BorderThickness="4"
                  CornerRadius="65"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <TextBlock Text="KNOB" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          
          <!-- Right Side - CW Action -->
          <StackPanel Grid.Column="2" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center">
            <TextBlock Text="↻" 
                       FontSize="28" 
                       Foreground="#00FFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
            <TextBlock Text="CW Action:" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <ComboBox x:Name="CwActionComboBox"
                      Width="160" 
                      Height="35" 
                      FontSize="14" 
                      Background="#404040" 
                      Foreground="White" 
                      BorderBrush="#707070" 
                      BorderThickness="2" 
                      CornerRadius="5"
                      HorizontalAlignment="Center">
              <ComboBoxItem Content="Increase Volume"/>
              <ComboBoxItem Content="Decrease Volume"/>
              <ComboBoxItem Content="Scroll Up"/>
              <ComboBoxItem Content="Scroll Down"/>
              <ComboBoxItem Content="Layer Count Up"/>
              <ComboBoxItem Content="Layer Count Down"/>
              <ComboBoxItem Content="None"/>
            </ComboBox>
          </StackPanel>
        </Grid>

        <!-- Lower Section: Press Action & Dynamic Options -->
        <StackPanel HorizontalAlignment="Center">
          
          <!-- Press Action Dropdown -->
          <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Press Action:" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="PressActionComboBox"
                      Width="180" 
                      Height="35" 
                      FontSize="14" 
                      Background="#404040" 
                      Foreground="White" 
                      BorderBrush="#707070" 
                      BorderThickness="2" 
                      CornerRadius="5"
                      HorizontalAlignment="Center"
                      SelectionChanged="PressActionComboBox_SelectionChanged">
              <ComboBoxItem Content="Key / Shortcut"/>
              <ComboBoxItem Content="Type Text"/>
              <ComboBoxItem Content="Layer Switch"/>
              <ComboBoxItem Content="None"/>
            </ComboBox>
          </StackPanel>
          
          <!-- Press Shortcut Recorder Panel -->
          <StackPanel x:Name="PressShortcutPanel" HorizontalAlignment="Center" Spacing="6" IsVisible="True">
            <views:KeyRecorderControl x:Name="PressKeyRecorder"/>
            
            <StackPanel x:Name="PressShortcutHoldToRepeatPanel"
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,2,0,0"
                        Spacing="8">
              <CheckBox x:Name="PressShortcutHoldToRepeatCheckBox"
                        IsChecked="False"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Background="Transparent"/>
              <TextBlock Text="Hold to Repeat" 
                         FontSize="14" 
                         Foreground="White" 
                         VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <!-- Press Key/Value Panel (for Type Text) -->
          <StackPanel x:Name="PressKeyValuePanel" HorizontalAlignment="Center" IsVisible="False" Margin="0,6,0,0">
            <TextBlock Text="Text to type:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <TextBox x:Name="PressKeyValueTextBox" Width="200" Height="32" FontSize="13" 
                     Background="#404040" Foreground="White" BorderBrush="#707070" 
                     BorderThickness="2" CornerRadius="5" Watermark="Enter text..."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Spacing="8">
              <CheckBox x:Name="PressTypeTextHoldToRepeatCheckBox"
                        IsChecked="False"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Background="Transparent"/>
              <TextBlock Text="Hold to Repeat" 
                         FontSize="14" 
                         Foreground="White" 
                         VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          
          <!-- Press Layer Switch Panel (for Layer Switch) -->
          <StackPanel x:Name="PressLayerSwitchPanel" HorizontalAlignment="Center" IsVisible="False" Margin="0,6,0,0">
            <TextBlock Text="Direction:" FontSize="14" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <ComboBox x:Name="PressLayerSwitchDirectionComboBox" 
                      Width="180" 
                      Height="32" 
                      FontSize="13"
                      Background="#404040" 
                      Foreground="White" 
                      BorderBrush="#707070" 
                      BorderThickness="2" 
                      CornerRadius="5"
                      SelectedIndex="0"
                      HorizontalAlignment="Center">
              <ComboBoxItem Content="Up"/>
              <ComboBoxItem Content="Down"/>
            </ComboBox>
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </Grid>
	  
    <!-- Save Button -->
    <Button Grid.Row="2"
            Content="Save" 
            Width="100" 
            Height="40" 
            FontSize="16" 
            FontWeight="Bold" 
            Background="#404040" 
            Foreground="White" 
            BorderBrush="#707070" 
            BorderThickness="2" 
            CornerRadius="5"
            HorizontalAlignment="Center"
            Margin="0,15,0,30"
            Click="SaveButton_Click"/>
    
  </Grid>
</Window>

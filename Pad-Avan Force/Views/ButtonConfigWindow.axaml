<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PadAwan_Force.Views"
        x:Class="PadAwan_Force.Views.ButtonConfigWindow"
        Title="Key Configuration"
        Width="460" Height="450"
        CanResize="False"
        Background="Black"
        Icon="/Assets/Pad-Avan Force logo v2.ico"
        WindowStartupLocation="CenterOwner">
  
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <!-- Top horizontal rectangle -->
    <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Fill="#1A1A1A" 
               Height="50" 
               VerticalAlignment="Top" 
               Margin="-30,-30,-30,0"/>
    
    <!-- Bottom horizontal rectangle -->
    <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
               Fill="#1A1A1A" 
               Height="50" 
               VerticalAlignment="Bottom" 
               Margin="-30,0,-30,-30"/>
    
    <!-- Title -->
    <TextBlock Grid.Row="0" 
               Text="Configuration:" 
               FontSize="32" 
               FontWeight="Bold" 
               Foreground="#00FFFF"
               HorizontalAlignment="Left" 
               Margin="-20,-25,0,20"/>

    <!-- Button Reference -->  
    <TextBlock x:Name="ButtonNumberText"
               Text="Button 1"
               FontSize="32" 
               FontWeight="Bold" 
               Foreground="#00FFFF"
               HorizontalAlignment="Right" 
               Margin="-20,-25,0,20"/>
    
    <!-- Configuration Content -->
    <StackPanel Grid.Row="1" Spacing="15" VerticalAlignment="Top" Margin="0,10,0,0">
      
      <!-- Button Label / Nickname -->
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Button Label (optional):" 
                   FontSize="15" 
                   FontWeight="Bold"
                   Foreground="White" 
                   Margin="0,0,0,6"
                   HorizontalAlignment="Center"/>
        <TextBox x:Name="ButtonLabelTextBox"
                 Width="250" 
                 Height="36" 
                 FontSize="14" 
                 Background="#404040" 
                 Foreground="White" 
                 BorderBrush="#707070" 
                 BorderThickness="2" 
                 CornerRadius="5"
                 Watermark="e.g. Mute, Screenshot..."/>
      </StackPanel>

      <!-- Action Type -->
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Action Type:" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Foreground="White" 
                   Margin="0,0,0,8"
                   HorizontalAlignment="Center"/>
        <ComboBox x:Name="ActionTypeComboBox"
                  Width="250" 
                  Height="40" 
                  FontSize="16" 
                  Background="#404040" 
                  Foreground="White" 
                  BorderBrush="#707070" 
                  BorderThickness="2" 
                  CornerRadius="5"
                  SelectionChanged="ActionTypeComboBox_SelectionChanged">
          <ComboBoxItem Content="Key / Shortcut"/>
          <ComboBoxItem Content="Type Text"/>
          <ComboBoxItem Content="Layer Switch"/>
          <ComboBoxItem Content="None"/>
        </ComboBox>
      </StackPanel>
      
      <!-- Key / Shortcut Recorder Panel -->
      <StackPanel x:Name="ShortcutPanel" HorizontalAlignment="Center" Spacing="8" IsVisible="True">
        <views:KeyRecorderControl x:Name="KeyRecorder"/>
        
        <StackPanel x:Name="ShortcutHoldToRepeatPanel"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,4,0,0"
                    Spacing="8">
          <CheckBox x:Name="ShortcutHoldToRepeatCheckBox"
                    IsChecked="False"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Background="Transparent"/>
          <TextBlock Text="Hold to Repeat" 
                     FontSize="14" 
                     Foreground="White" 
                     VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Key/Value Input (for Type Text) -->
      <StackPanel x:Name="KeyValuePanel" HorizontalAlignment="Center" IsVisible="False">
        <TextBlock Text="Text to type:" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Foreground="White" 
                   Margin="0,0,0,8"
                   HorizontalAlignment="Center"/>
        <TextBox x:Name="KeyValueTextBox"
                 Width="250" 
                 Height="40" 
                 FontSize="16" 
                 Background="#404040" 
                 Foreground="White" 
                 BorderBrush="#707070" 
                 BorderThickness="2" 
                 CornerRadius="5"
                 Watermark="Enter text..."/>
        <StackPanel x:Name="HoldToRepeatPanel"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0"
                    Spacing="8">
          <CheckBox x:Name="HoldToRepeatCheckBox"
                    IsChecked="False"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Background="Transparent"/>
          <TextBlock Text="Hold to Repeat" 
                     FontSize="14" 
                     Foreground="White" 
                     VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Layer Switch Direction Panel (for Layer Switch) -->
      <StackPanel x:Name="LayerSwitchPanel" HorizontalAlignment="Center" IsVisible="False">
        <TextBlock Text="Direction:"
                   HorizontalAlignment="Center"
                   FontSize="16" 
                   FontWeight="Bold"
                   Foreground="White" 
                   Margin="0,0,0,8"/>
        
        <ComboBox x:Name="LayerSwitchDirectionComboBox" 
                  Width="250" 
                  Height="40" 
                  FontSize="16"
                  Background="#404040" 
                  Foreground="White" 
                  BorderBrush="#707070" 
                  BorderThickness="2" 
                  CornerRadius="5"
                  SelectedIndex="0">
          <ComboBoxItem Content="Up"/>
          <ComboBoxItem Content="Down"/>
        </ComboBox>
      </StackPanel>
      
    </StackPanel>
    
    <!-- Save Button -->
    <Button Grid.Row="2" 
            x:Name="SaveButton"
            Content="Save" 
            Width="100" 
            Height="40" 
            FontSize="16" 
            FontWeight="Bold" 
            Background="#404040" 
            Foreground="White" 
            BorderBrush="#707070" 
            BorderThickness="2" 
            CornerRadius="5"
            HorizontalAlignment="Center"
            Margin="0,15,0,30"
            Click="SaveButton_Click"/>
    
  </Grid>
</Window>

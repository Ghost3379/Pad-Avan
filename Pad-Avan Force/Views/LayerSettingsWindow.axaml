<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PadAwan_Force.Models"
        x:Class="PadAwan_Force.Views.LayerSettingsWindow"
        Title="Layer Settings"
        Width="500" Height="550"
        CanResize="False"
        Background="Black"
        Icon="/Assets/Pad-Avan Force logo v2.ico"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Border#DragHandle:pointerover Ellipse">
      <Setter Property="Fill" Value="#00FFFF"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">
    
    <!-- Top horizontal header bar -->
    <Border Grid.Row="0"
            Background="#1A1A1A"
            Height="65"
            Padding="25,0">
      <TextBlock Text="Layer Settings" 
                 FontSize="28" 
                 FontWeight="Bold" 
                 Foreground="#00FFFF"
                 VerticalAlignment="Center"/>
    </Border>
    
    <!-- Layer List with Drag and Drop -->
    <ScrollViewer Grid.Row="1"
                  x:Name="LayerScrollViewer"
                  Margin="25,12,25,6"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="LayerItemsControl">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" Spacing="8"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Layer">
            <Border x:Name="LayerBorder"
                    Background="#404040" 
                    CornerRadius="5" 
                    Padding="10,8"
                    BorderBrush="#707070"
                    BorderThickness="2">
              <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Drag Handle -->
                <Border x:Name="DragHandle"
                        Grid.Column="0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        Padding="6,6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Click and drag up or down to reorder layer"
                        PointerPressed="DragHandle_PointerPressed">
                  <StackPanel Orientation="Vertical" Spacing="3" Width="12" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                      <Ellipse Width="3" Height="3" Fill="#707070"/>
                      <Ellipse Width="3" Height="3" Fill="#707070"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                      <Ellipse Width="3" Height="3" Fill="#707070"/>
                      <Ellipse Width="3" Height="3" Fill="#707070"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                      <Ellipse Width="3" Height="3" Fill="#707070"/>
                      <Ellipse Width="3" Height="3" Fill="#707070"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                
                <!-- Layer Name TextBox (Inline Editing) -->
                <TextBox Grid.Column="1"
                         Text="{Binding Name, Mode=TwoWay}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Background="#2D2D2D"
                         Foreground="White"
                         BorderBrush="#606060"
                         BorderThickness="1"
                         CornerRadius="4"
                         Padding="10,6"
                         VerticalAlignment="Center"
                         LostFocus="LayerNameTextBox_LostFocus"/>
                
                <!-- Layer ID Display / Layer 1 Badge -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Spacing="8">
                  <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}"
                             FontSize="12"
                             Foreground="#888888"
                             VerticalAlignment="Center"/>
                  <Border x:Name="Layer1Badge"
                          Background="#00FFFF"
                          CornerRadius="3"
                          Padding="6,2"
                          IsVisible="False">
                    <TextBlock Text="Layer 1"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="Black"
                               VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    
    <!-- Bottom Controls: Wrap Around CheckBox and Save Button -->
    <StackPanel Grid.Row="2"
                Margin="25,4,25,12"
                Spacing="12"
                HorizontalAlignment="Stretch">
      <CheckBox x:Name="WrapAroundCheckBox"
                Content="Enable wrap-around (loop through layers)"
                FontSize="13"
                Foreground="White"
                HorizontalAlignment="Left"
                IsChecked="True"/>

      <!-- Save Button -->
      <Button x:Name="SaveButton"
              Content="Save" 
              Width="120" 
              Height="36" 
              FontSize="15" 
              FontWeight="Bold" 
              Background="#404040" 
              Foreground="White" 
              BorderBrush="#707070" 
              BorderThickness="2" 
              CornerRadius="5"
              HorizontalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Click="SaveButton_Click"/>
    </StackPanel>
    
    <!-- Bottom Framing Bar with Note -->
    <Border Grid.Row="3"
            Background="#1A1A1A"
            Height="45"
            Padding="20,0">
      <TextBlock Text="Note: The first Layer is protected and cannot be moved or deleted" 
                 FontSize="11" 
                 Foreground="#707070" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"/>
    </Border>
    
  </Grid>
</Window>

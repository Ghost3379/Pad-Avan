<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PadAwan_Force.ViewModels"
        x:Class="PadAwan_Force.Views.UpdateWindow"
        x:DataType="vm:UpdateWindowViewModel"
        Title="Update Manager"
        Width="720" Height="580"
        CanResize="False"
        Background="Black"
        Icon="/Assets/Pad-Avan Force logo v2.ico"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button.action-btn">
      <Setter Property="Background" Value="#00FFFF"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="BorderBrush" Value="#00AAAA"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.action-btn:pointerover">
      <Setter Property="Background" Value="#33FFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFF"/>
    </Style>
    <Style Selector="Button.action-btn:disabled">
      <Setter Property="Background" Value="#404040"/>
      <Setter Property="Foreground" Value="#707070"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>

    <Style Selector="Button.standard-btn">
      <Setter Property="Background" Value="#404040"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#707070"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.standard-btn:pointerover">
      <Setter Property="Background" Value="#505050"/>
      <Setter Property="BorderBrush" Value="#00FFFF"/>
    </Style>
    <Style Selector="Button.standard-btn:disabled">
      <Setter Property="Background" Value="#303030"/>
      <Setter Property="Foreground" Value="#606060"/>
      <Setter Property="BorderBrush" Value="#454545"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top Bar -->
    <Border Grid.Row="0" Background="#1A1A1A" Height="60" Padding="25,0">
      <TextBlock Text="Update Manager" 
                 FontSize="32" 
                 FontWeight="Bold" 
                 Foreground="#00FFFF"
                 VerticalAlignment="Center"/>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Row="1" Margin="25,16,25,16" RowDefinitions="Auto,Auto,*">

      <!-- Check for Updates Button -->
      <Button Grid.Row="0"
              Content="Check for Updates" 
              Classes="standard-btn"
              Width="190" 
              Height="36" 
              FontSize="14" 
              HorizontalAlignment="Center"
              Margin="0,0,0,14"
              Command="{Binding CheckForUpdatesCommand}"
              IsEnabled="{Binding !IsUpdating}"/>

      <!-- Progress Banner (Visible when updating) -->
      <Border Grid.Row="1" 
              Background="#2A2A2A" 
              CornerRadius="10" 
              Padding="16,10" 
              Margin="0,0,0,14"
              IsVisible="{Binding IsUpdating}">
        <StackPanel Spacing="6">
          <Grid>
            <TextBlock Text="{Binding UpdateStatus}" 
                       FontSize="13" 
                       FontWeight="Bold"
                       Foreground="White" 
                       HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding UpdateProgressText}" 
                       FontSize="12" 
                       Foreground="#B0B0B0" 
                       HorizontalAlignment="Right"/>
          </Grid>
          <ProgressBar Value="{Binding UpdateProgress}" 
                       Maximum="100" 
                       Height="10"
                       CornerRadius="5"
                       Background="#404040"
                       Foreground="#00FFFF"/>
        </StackPanel>
      </Border>

      <!-- Side-by-Side Cards -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20">

        <!-- Device Firmware Card -->
        <Border Grid.Column="0" 
                Background="#2A2A2A" 
                CornerRadius="10" 
                Padding="18,16">
          <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock Grid.Row="0"
                       Text="Device Firmware" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,14">
              <TextBlock Text="Status: " 
                         FontSize="14" 
                         Foreground="White"/>
              <TextBlock Text="{Binding FirmwareStatusBadge}" 
                         FontSize="14" 
                         FontWeight="SemiBold"
                         Foreground="{Binding FirmwareStatusColor}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="14">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Installed on Device:" 
                           FontSize="13" 
                           Foreground="#B0B0B0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DeviceFirmwareVersion}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#00FFFF" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
              </StackPanel>

              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Latest Available:" 
                           FontSize="13" 
                           Foreground="#B0B0B0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LatestFirmwareDisplay}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="LimeGreen" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>

            <Button Grid.Row="3"
                    Content="Update Firmware" 
                    Classes="action-btn"
                    Width="180" 
                    Height="38" 
                    FontSize="13" 
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    IsEnabled="{Binding CanUpdateFirmware}"
                    Command="{Binding UpdateFirmwareCommand}"/>

            <TextBlock Grid.Row="4"
                       Text="Puts device in bootloader mode and opens web flasher."
                       FontSize="11" 
                       Foreground="#909090" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"
                       MaxWidth="280"
                       Margin="0,8,0,0"/>
          </Grid>
        </Border>

        <!-- Desktop Application Card -->
        <Border Grid.Column="1" 
                Background="#2A2A2A" 
                CornerRadius="10" 
                Padding="18,16">
          <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock Grid.Row="0"
                       Text="Desktop Application" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,14">
              <TextBlock Text="Status: " 
                         FontSize="14" 
                         Foreground="White"/>
              <TextBlock Text="{Binding SoftwareStatusBadge}" 
                         FontSize="14" 
                         FontWeight="SemiBold"
                         Foreground="{Binding SoftwareStatusColor}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="14">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Current Version:" 
                           FontSize="13" 
                           Foreground="#B0B0B0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SoftwareVersion}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#00FFFF" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
              </StackPanel>

              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Latest Available:" 
                           FontSize="13" 
                           Foreground="#B0B0B0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LatestSoftwareDisplay}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="LimeGreen" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>

            <Button Grid.Row="3"
                    Content="Update Application" 
                    Classes="action-btn"
                    Width="180" 
                    Height="38" 
                    FontSize="13" 
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    IsEnabled="{Binding CanUpdateSoftware}"
                    Command="{Binding UpdateSoftwareCommand}"/>

            <TextBlock Grid.Row="4"
                       Text="Installs update silently and restarts app automatically."
                       FontSize="11" 
                       Foreground="#909090" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"
                       MaxWidth="280"
                       Margin="0,8,0,0"/>
          </Grid>
        </Border>

      </Grid>
    </Grid>

    <!-- Bottom Bar with Status Message -->
    <Border Grid.Row="2" Background="#1A1A1A" Height="48" Padding="20,0">
      <TextBlock Text="{Binding StatusMessage}" 
                 FontSize="13" 
                 FontWeight="SemiBold"
                 Foreground="{Binding StatusMessageColor}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 TextAlignment="Center"/>
    </Border>

  </Grid>
</Window>
